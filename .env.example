# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Django core ---
# Generate a real key, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must NOT contain "django-insecure" in production (DEBUG=False) -- settings.py
# will refuse to start otherwise.
SECRET_KEY=
# True for local development only. Must be False in production.
DEBUG=True
# Comma-separated, no brackets, no spaces around commas. Only read when
# DEBUG=False. Example: ALLOWED_HOSTS=api.example.com,www.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# 'mysql' (default, matches local dev) or 'postgresql' (used in production).
DB_ENGINE=mysql
NAME=
HOST=
USER=
PASSWORD=
# Leave blank to use the engine's default port (3306 for mysql, 5432 for
# postgresql). Set explicitly if your Postgres host uses a non-default port
# (e.g. a connection pooler).
DB_PORT=

# --- Email (SMTP, used for account activation emails) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Used to build activation links that point at the frontend, e.g.:
# EMAIL_FRONTEND_PROTOCOL=https / EMAIL_FRONTEND_DOMAIN=app.example.com
EMAIL_FRONTEND_PROTOCOL=http
EMAIL_FRONTEND_DOMAIN=localhost:5173
EMAIL_FRONTEND_SITE_NAME=Dex Store

# --- Gemini / chatbot ---
GEMINI_API_KEY=
# Seconds to cache an AI-generated review summary for. Optional, defaults to 3600.
REVIEW_SUMMARY_CACHE_TTL=3600

# --- Redis (cache backend; also the Celery broker/result backend below) ---
# Required in production -- there is no in-memory fallback. Defaults to
# redis://localhost:6379/0 if unset, which will not exist in production.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- CORS / CSRF (production only) ---
# Comma-separated origin(s) of the deployed frontend, including scheme.
# Defaults to http://localhost:5173 if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Only needed if the Django admin is accessed over a domain Django wouldn't
# otherwise trust for CSRF (e.g. behind a proxy/custom domain). Comma-separated,
# each entry must include the scheme, e.g. https://api.example.com
CSRF_TRUSTED_ORIGINS=
